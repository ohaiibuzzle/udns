#!/bin/sh /etc/rc.common
# procd init script for udns. Install as /etc/init.d/udns, then:
#   chmod +x /etc/init.d/udns && /etc/init.d/udns enable && /etc/init.d/udns start

# Start just before dnsmasq (19) so it can forward to udns from boot.
START=18
STOP=89
USE_PROCD=1

PROG=/usr/bin/udns
CONF=/etc/udns.toml

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" "$CONF"
	procd_set_param file "$CONF"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
